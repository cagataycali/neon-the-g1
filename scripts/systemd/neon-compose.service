[Unit]
Description=NEON G1 — docker compose stack (agent + dashboard + telegram + thinker)
# time-sync.target: the Jetson boots at 1970 (no RTC battery); personas that start before
# NTP mint 1980-dated camera proxy tokens. Wait for the clock.
After=network-online.target docker.service graphical.target time-sync.target
Wants=network-online.target time-sync.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/home/unitree/neon-the-g1
# bring the whole stack up; --remove-orphans keeps it clean
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose stop
TimeoutStartSec=600

[Install]
WantedBy=default.target
