[Unit]
Description=neon · G1 Agent (docker compose)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=__WORKDIR__
# build-if-needed so a fresh checkout comes up cleanly; .env is auto-loaded
ExecStart=/usr/bin/docker compose up --build -d
ExecStop=/usr/bin/docker compose down
TimeoutStartSec=1200
# best-effort restart if the oneshot bring-up fails
Restart=on-failure
RestartSec=15

[Install]
WantedBy=multi-user.target
