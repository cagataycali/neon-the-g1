# Copy to .env (gitignored) and fill in your secrets.
# docker compose auto-loads this file when it sits next to docker-compose.yml.

# --- AWS Bedrock — REPL agent (Claude Opus) + nova_sonic voice ----------
AWS_BEARER_TOKEN_BEDROCK=
AWS_DEFAULT_REGION=us-west-2

# --- OpenAI Realtime (default voice provider for g1_speak) --------------
OPENAI_API_KEY=
# VOICE_PROVIDER=openai                # openai | nova_sonic | gemini (default: openai)
# VOICE_NAME=alloy                     # alloy/ash/ballad/coral/echo/sage/shimmer/verse/marin/cedar
# VOICE_MODEL=gpt-realtime             # only for openai provider; e.g. gpt-realtime / gpt-realtime-mini
# VOICE_NO_AEC=0                       # 1 = disable WebRTC AEC (NOT recommended for G1 chest speaker)
# VOICE_RESTART_DELAY=5                # seconds between auto-restart attempts

# --- Gemini Live (alternative voice provider) ---------------------------
# GOOGLE_API_KEY=
# GEMINI_API_KEY=

# --- Telegram bot — multi-turn agent + /mute /unmute /state /battery ----
# Get a token from @BotFather; add yourself with TELEGRAM_ALLOWED_USERS.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_ALLOWED_USERS=cagataycali    # comma-separated usernames or numeric IDs
# TELEGRAM_DEFAULT_CHAT_ID=             # injected into voice persona prompt
# TELEGRAM_HISTORY_LIMIT=20             # messages injected per chat into REPL prompt

# --- G1 robot wiring ----------------------------------------------------
G1_NETWORK_INTERFACE=eth0               # DDS interface — robot is on 192.168.123.0/24
# VOICE_MIC_NAME: comma-separated name substrings to auto-pick mic (case-insensitive,
# priority order). Default: DJI,Logi,Brio,USB,Mic. Works for DJI receiver / any USB mic.
# VOICE_MIC_NAME=DJI
# BRIO_DEVICE_INDEX=                      # PyAudio device index for the Brio mic (override autopick)
                                        # Find with: python -c "import pyaudio; p=pyaudio.PyAudio(); [print(i, p.get_device_info_by_index(i)['name']) for i in range(p.get_device_count())]"

# --- REPL agent behaviour -----------------------------------------------
# NEON_NO_SPEECH=1                       # skip g1_speak auto-start at REPL boot

# --- DevDuck (when imported by dispatch tool) ------------------
DEVDUCK_AUTO_START_SERVERS=false
DEVDUCK_AMBIENT_MODE=false
BYPASS_TOOL_CONSENT=true

